# =============================================================================
# ⚠️  SECURITY WARNING
# =============================================================================
# This is a TEMPLATE file. Copy it to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# For production, use your hosting platform's environment variable manager.
#
# 🔴 CRITICAL: Never commit real API keys, secrets, or connection strings.
# =============================================================================

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
SERVERLESS=false

# ─── Database (REQUIRED for most features) ──────────────────────────────────
# Uses MONGODB_URI first; falls back to MONGO_URI for backward compatibility.
MONGODB_URI=mongodb://localhost:27017/youtube-ai
# MONGO_URI=mongodb://localhost:27017/youtube-ai  # fallback if MONGODB_URI is not set

# ─── Security / Auth (REQUIRED) ─────────────────────────────────────────────
# Generate strong keys with: openssl rand -hex 32
API_KEY=your_api_key_here_min_32_chars
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ─── AI: Script Generation (REQUIRED) ──────────────────────────────────────
# Get a Groq API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Video Footage (REQUIRED) ──────────────────────────────────────────────
# Get a Pexels API key at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# ─── YouTube / Google OAuth (REQUIRED for uploads) ──────────────────────────
# Set up a Google Cloud project and enable the YouTube Data API v3.
# Create OAuth 2.0 credentials (Web application type).
YOUTUBE_API_KEY=your_youtube_api_key
YT_CLIENT_ID=your_client_id.apps.googleusercontent.com
YT_CLIENT_SECRET=GOCSPX-your_secret
YT_REDIRECT_URI=http://localhost:5000/api/youtube/callback

# ─── Credential Encryption Key (REQUIRED if using YouTube OAuth) ───────────
# Used by the ServerCredential model to encrypt OAuth tokens at rest.
# Generate with: openssl rand -hex 32
# IMPORTANT: If this key is lost, existing encrypted credentials cannot be recovered.
CREDENTIAL_ENCRYPTION_KEY=

# ─── Rate Limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Pipeline ───────────────────────────────────────────────────────────────
PIPELINE_RATE_LIMIT=5
YOUTUBE_UPLOAD_RATE_LIMIT=3

# ─── Deployment / CORS ──────────────────────────────────────────────────────
# In production, set this to your frontend URL (e.g. https://autotube.vercel.app)
FRONTEND_URL=http://localhost:3000

# ─── Frontend (Vite) ──────────────────────────────────────────────────
# Set this in client/.env or client/.env.production for the frontend
# Must match the API_KEY value above
VITE_API_KEY=

# ─── Storage ────────────────────────────────────────────────────────────────
# Path to storage directory for generated assets (default: ./storage)
STORAGE_PATH=./storage

# ─── FIFA World Cup Scheduler (optional — enable for match-driven content) ──
WORLD_CUP_MODE=true
MATCH_POLL_INTERVAL_MS=300000
WORLD_CUP_START_DATE=2026-06-11
WORLD_CUP_END_DATE=2026-07-19

# ─── ImageKit (REQUIRED in production) ──────────────────────────────────────
# ImageKit handles image/video optimisation, transformations, and CDN delivery.
# Sign up at https://imagekit.io and get these from your dashboard:
#   1. Go to Dashboard → Developer → API Keys
#   2. Copy the Public Key, Private Key, and URL Endpoint
#   3. Set up folder structure in ImageKit dashboard (audio/, videos/, thumbnails/, etc.)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
