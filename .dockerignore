# =============================================================================
# .dockerignore — exclude unnecessary files from Docker build context
# =============================================================================

# Dependencies
node_modules/
client/node_modules/

# Environment files
.env
.env.*
!.env.example

# Version control
.git/
.gitignore
.gitattributes

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output (will be rebuilt in Docker)
dist/
build/
client/dist/

# Storage / generated assets
storage/
assets/generated/
tmp/
temp/

# Coverage
coverage/
.nyc_output/

# Docker files (not needed in build context)
Dockerfile
.dockerignore
docker-compose*.yml

# Documentation (not needed for build)
*.md

# CI/CD
.github/
